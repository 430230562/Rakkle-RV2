<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- ==========================================================================================
       Rakkle ranged vore weapons
       ========================================================================================== -->

    <!-- Projectile that yanks the pawn it hits back to the caster (see RakkleVoreProjectile.cs) -->
    <ThingDef ParentName="BaseBullet">
        <defName>RS_VoreTongueProjectile</defName>
        <label>engulfing tongue</label>
        <thingClass>Rakkle.Projectile_VoreTongue</thingClass>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Small</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <projectile>
            <damageDef>Blunt</damageDef>
            <damageAmountBase>0</damageAmountBase>
            <speed>40</speed>
        </projectile>
    </ThingDef>

    <!-- Dart that delivers the Rakkle's numbing venom at range, so prey stops struggling -->
    <ThingDef ParentName="BaseBullet">
        <defName>RS_AnestheticDart</defName>
        <label>anesthetic dart</label>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Small</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <projectile>
            <damageDef>RS_AnestheticDartDamage</damageDef>
            <damageAmountBase>3</damageAmountBase>
            <speed>45</speed>
        </projectile>
    </ThingDef>

    <ThingDef ParentName="BaseHumanMakeableGun">
        <defName>RS_AnestheticNeedler</defName>
        <label>anesthetic needler</label>
        <description>A Rakkle predation weapon that fires darts coated in the species' numbing
            venom, quietly putting a struggling victim to sleep so it can be swallowed without a
            fight.</description>
        <graphicData>
            <texPath>Things/Item/Equipment/WeaponRanged/Autopistol</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <uiIconScale>1.5</uiIconScale>
        <soundInteract>Interact_Autopistol</soundInteract>
        <statBases>
            <WorkToMake>6000</WorkToMake>
            <Mass>1.3</Mass>
            <AccuracyTouch>0.80</AccuracyTouch>
            <AccuracyShort>0.72</AccuracyShort>
            <AccuracyMedium>0.45</AccuracyMedium>
            <AccuracyLong>0.30</AccuracyLong>
            <RangedWeapon_Cooldown>1.6</RangedWeapon_Cooldown>
        </statBases>
        <weaponTags>
            <li>RS_VoreWeapon</li>
        </weaponTags>
        <weaponClasses>
            <li>RangedLight</li>
        </weaponClasses>
        <costList>
            <Steel>25</Steel>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>
        <recipeMaker>
            <skillRequirements>
                <Crafting>5</Crafting>
            </skillRequirements>
            <displayPriority>521</displayPriority>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>RS_AnestheticDart</defaultProjectile>
                <warmupTime>0.8</warmupTime>
                <range>18.9</range>
                <burstShotCount>2</burstShotCount>
                <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
                <soundCast>Shot_Autopistol</soundCast>
                <muzzleFlashScale>6</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>muzzle</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>7</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
    </ThingDef>

</Defs>