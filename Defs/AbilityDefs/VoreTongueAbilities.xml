<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <AbilityCategoryDef>
        <defName>RS_RakklePredation</defName>
        <label>Rakkle predation</label>
        <displayOrder>110</displayOrder>
    </AbilityCategoryDef>

    <!-- Rakkle growth ability: earned by digesting prey (see RakkleTongueUpgrade.cs) -->

    <!-- Tier 1 -->
    <AbilityDef>
        <defName>RS_predatoryLeap</defName>
        <label>predatory leap</label>
        <description>The Rakkle leaps toward a distant target and immediately attempts to seize it
            in a RimVore-2 grapple upon landing.</description>
        <iconPath>Icon/RS_Icon</iconPath>
        <category>RS_RakklePredation</category>
        <displayOrder>10</displayOrder>
        <aiCanUse>true</aiCanUse>
        <ai_IsOffensive>true</ai_IsOffensive>
        <showWhenDrafted>true</showWhenDrafted>
        <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
        <cooldownTicksRange>900</cooldownTicksRange>
        <jobDef>CastJump</jobDef>
        <verbProperties>
            <verbClass>Verb_CastAbilityJump</verbClass>
            <range>12.9</range>
            <warmupTime>1.0</warmupTime>
            <violent>false</violent>
            <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
            <soundCast>Longjump_Jump</soundCast>
            <soundLanding>Longjump_Land</soundLanding>
            <requireLineOfSight>true</requireLineOfSight>
            <targetParams>
                <canTargetPawns>true</canTargetPawns>
                <canTargetAnimals>true</canTargetAnimals>
                <canTargetMechs>false</canTargetMechs>
                <canTargetLocations>false</canTargetLocations>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="Rakkle.CompProperties_AbilityEffect_VoreLeap">
            </li>
        </comps>
    </AbilityDef>

    <!-- Tier 2: longer reach and faster recovery -->
    <AbilityDef>
        <defName>RS_predatoryLeapMature</defName>
        <label>predatory leap (mature)</label>
        <description>A mature predatory leap with greater range and a faster recovery, allowing
            the Rakkle to close on distant prey and immediately attempt a RimVore-2 grapple.</description>
        <iconPath>Icon/RS_Icon</iconPath>
        <category>RS_RakklePredation</category>
        <displayOrder>11</displayOrder>
        <aiCanUse>true</aiCanUse>
        <ai_IsOffensive>true</ai_IsOffensive>
        <showWhenDrafted>true</showWhenDrafted>
        <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
        <cooldownTicksRange>600</cooldownTicksRange>
        <jobDef>CastJump</jobDef>
        <verbProperties>
            <verbClass>Verb_CastAbilityJump</verbClass>
            <range>18.9</range>
            <warmupTime>0.8</warmupTime>
            <violent>false</violent>
            <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
            <soundCast>Longjump_Jump</soundCast>
            <soundLanding>Longjump_Land</soundLanding>
            <requireLineOfSight>true</requireLineOfSight>
            <targetParams>
                <canTargetPawns>true</canTargetPawns>
                <canTargetAnimals>true</canTargetAnimals>
                <canTargetMechs>false</canTargetMechs>
                <canTargetLocations>false</canTargetLocations>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="Rakkle.CompProperties_AbilityEffect_VoreLeap">
            </li>
        </comps>
    </AbilityDef>

</Defs>