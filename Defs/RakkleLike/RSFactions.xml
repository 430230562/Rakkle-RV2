<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<FactionDef Abstract="True" Name="RS_PlayerFactionBase">
		<settlementTexturePath>Icon/RS_Icon</settlementTexturePath>
		<colorSpectrum>
			<li>(0.35, 0.67, 0.84)</li>
		</colorSpectrum>
		<raidLootValueFromPointsCurve>
			<points>
				<li>(35, 8)</li>
				<li>(100, 60)</li>
				<li>(1000, 250)</li>
				<li>(2000, 400)</li>
				<li>(4000, 500)</li>
			</points>
		</raidLootValueFromPointsCurve>
	</FactionDef>


	<!-- 플레이어 -->
	<FactionDef ParentName="RS_PlayerFactionBase">
		<defName>RS_PlayerFaction</defName>
		<label>New Rakkle Beginning</label>
		<description>This is your Rakkle settlement.</description>
		<isPlayer>true</isPlayer>
		<basicMemberKind>RS_Colonist</basicMemberKind>
		<pawnSingular>Rakkle</pawnSingular>
		<pawnsPlural>Rakkles</pawnsPlural>
		<techLevel>Industrial</techLevel>
		<backstoryCategories>
			<li>Offworld</li>
		</backstoryCategories>
		<allowedCultures>
			<li>RS_Culture_Standard</li>
		</allowedCultures>
		<requiredMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">RV2_Predation</li>
		</requiredMemes>
		<factionIconPath>Icon/RS_Icon</factionIconPath>
		<settlementTexturePath>Icon/RS_HomeIcon</settlementTexturePath>
		<playerInitialSettlementNameMaker>NamerInitialSettlementColony</playerInitialSettlementNameMaker>
		<factionNameMaker>NamerFactionOutlander</factionNameMaker>
		<settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
		<melaninRange>1</melaninRange>
		<startingResearchTags>
			<li>ClassicStart</li>
		</startingResearchTags>
		<apparelStuffFilter>
			<thingDefs>
				<li>Cloth</li>
			</thingDefs>
		</apparelStuffFilter>
	</FactionDef>


	<!-- 요람 -->
	<FactionDef ParentName="FactionBase" Name="CradleFactionBase" Abstract="True">
		<pawnSingular>Rakkle</pawnSingular>
		<pawnsPlural>Rakkles</pawnsPlural>
		<listOrderPriority>40</listOrderPriority>
		<settlementGenerationWeight>1</settlementGenerationWeight>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<canMakeRandomly>true</canMakeRandomly>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<humanlikeFaction>true</humanlikeFaction>
		<canUseAvoidGrid>true</canUseAvoidGrid>
		<leaderTitle>Cradle Leader</leaderTitle>
		<factionIconPath>Icon/CRD_Icon</factionIconPath>
		<factionNameMaker>NamerFactionCradle</factionNameMaker>
		<settlementNameMaker>NamerSettlementCradle</settlementNameMaker>
		<raidLootMaker>RakkleRaidLootMaker</raidLootMaker>
		<useFactionXenotypes>true</useFactionXenotypes>
		<xenotypeSet Inherit="False">
			<xenotypeChances>
				<Xenotype_RakkleBase>1</Xenotype_RakkleBase>
			</xenotypeChances>
		</xenotypeSet>

		<requiredMemes> <!--필수로
			들어가는 meme지정-->
			<li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">RV2_Predation</li>
		</requiredMemes>
		<disallowedMemes> <!--포함시키지
			않는 meme지정-->
			<li MayRequire="Ludeon.RimWorld.Ideology">FleshPurity</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">MaleSupremacy</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">FemaleSupremacy</li>
		</disallowedMemes>
		<disallowedPrecepts>
			<li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Strong_Subordinate</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Soft_Subordinate</li>
		</disallowedPrecepts>
		<structureMemeWeights>    <!--기반이념(종교같은
			큰틀)의 비율-->
			<Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Ideological>
		</structureMemeWeights>

		<colorSpectrum>
			<li>(0.78, 0.18, 0.14)</li>
			<li>(0.78, 0.18, 0.14)</li>
		</colorSpectrum>

		<caravanTraderKinds>
			<li>Caravan_Outlander_BulkGoods</li>
			<li>Caravan_Outlander_CombatSupplier</li>
			<li>Caravan_Outlander_Exotic</li>
		</caravanTraderKinds>
		<visitorTraderKinds>
			<li>Visitor_Outlander_Standard</li>
		</visitorTraderKinds>
		<baseTraderKinds>
			<li>Base_Outlander_Standard</li>
		</baseTraderKinds>

		<!-- Relations are set in RakkleFactionRelations.cs: -80 to everyone,
		     permanent hostility only towards a Rakkle player colony (RS_PlayerFaction) -->
		<techLevel>Spacer</techLevel>
		<backstoryCategories>
			<li>Offworld</li>
		</backstoryCategories>
		<allowedCultures>
			<li>RS_Culture_Standard</li>
		</allowedCultures>
		<melaninRange>0.8</melaninRange>

		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,35)</li>
				<li>(70, 50)</li>
				<li>(700, 100)</li>
				<li>(1300, 150)</li>
				<li>(100000, 10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
		<raidLootValueFromPointsCurve>
			<points>
				<li>(35, 15)</li>
				<li>(100, 120)</li>
				<li>(1000, 500)</li>
				<li>(2000, 800)</li>
				<li>(4000, 1000)</li>
			</points>
		</raidLootValueFromPointsCurve>
		<raidCommonalityFromPointsCurve>
			<points>
				<li>(10, 1)</li>
				<li>(700, 1)</li>
				<li>(2400, 1.5)</li>
				<li>(3800, 2.1)</li>
				<li>(5000, 2.2)</li>
				<li>(6500, 2.4)</li>
				<li>(8000, 2.6)</li>
			</points>
		</raidCommonalityFromPointsCurve>

		<pawnGroupMakers>
			<li>
				<!-- Normal fights, ranged with melee mix-ins -->
				<kindDef>Combat</kindDef>
				<commonality>100</commonality>
				<options>
					<CRD_Goods>10</CRD_Goods>
					<CRD_Kidnapper>10</CRD_Kidnapper>
					<CRD_Gunner>10</CRD_Gunner>
					<CRD_Slasher>10</CRD_Slasher>
					<CRD_Sapper>2</CRD_Sapper>
					<CRD_HeavyGunner>5</CRD_HeavyGunner>
					<CRD_EliteSlasher>3</CRD_EliteSlasher>
					<CRD_EliteGunner>7</CRD_EliteGunner>
				</options>
			</li>
			<li>
				<!-- Normal fights, melee-only -->
				<kindDef>Combat</kindDef>
				<commonality>30</commonality>
				<disallowedStrategies>
					<li>Siege</li>
				</disallowedStrategies>
				<options>
					<CRD_Goods>10</CRD_Goods>
					<CRD_Slasher>8</CRD_Slasher>
					<CRD_EliteSlasher>5</CRD_EliteSlasher>
				</options>
			</li>
			<li>
				<!-- Normal fights, ranged only -->
				<kindDef>Combat</kindDef>
				<commonality>20</commonality>
				<options>
					<CRD_Kidnapper>10</CRD_Kidnapper>
					<CRD_Gunner>10</CRD_Gunner>
					<CRD_Sapper>2</CRD_Sapper>
					<CRD_EliteGunner>6</CRD_EliteGunner>
				</options>
			</li>
			<li>
				<!-- Normal fights, explosives with ranged mix-ins -->
				<kindDef>Combat</kindDef>
				<commonality>15</commonality>
				<disallowedStrategies>
					<li>Siege</li>
				</disallowedStrategies>
				<options>
					<CRD_ShieldSlave>10</CRD_ShieldSlave>
					<CRD_Sapper>6</CRD_Sapper>
					<CRD_Gunner>3</CRD_Gunner>
					<CRD_HeavyGunner>5</CRD_HeavyGunner>
					<CRD_EliteGunner>2</CRD_EliteGunner>
				</options>
			</li>
			<li>
				<!-- Normal fights, ShieldSlaves only-->
				<kindDef>Combat</kindDef>
				<commonality>2.5</commonality>
				<maxTotalPoints>1000</maxTotalPoints>
				<options>
					<CRD_ShieldSlave>10</CRD_ShieldSlave>
				</options>
			</li>
			<!-- 노예 돌격 엘리트 부대 -->
			<li>
				<kindDef>Combat</kindDef>
				<commonality>15</commonality>
				<disallowedStrategies>
					<li>Siege</li>
				</disallowedStrategies>
				<options>
					<CRD_ShieldSlave>30</CRD_ShieldSlave>
					<CRD_Sapper>3</CRD_Sapper>
					<CRD_EliteSlasher>5</CRD_EliteSlasher>
					<CRD_EliteGunner>10</CRD_EliteGunner>
					<CradleLeader>4</CradleLeader>
				</options>
			</li>
			<li>
				<!-- Base defense-->
				<kindDef>Settlement</kindDef>
				<options>
					<CRD_Goods>3</CRD_Goods>
					<CRD_Gunner>10</CRD_Gunner>
					<CRD_Slasher>10</CRD_Slasher>
					<CRD_Sapper>3</CRD_Sapper>
					<CRD_EliteSlasher>10</CRD_EliteSlasher>
					<CRD_EliteGunner>10</CRD_EliteGunner>
					<CradleLeader>10</CradleLeader>
				</options>
			</li>
		</pawnGroupMakers>
		<settlementTexturePath>Icon/CRD_Icon</settlementTexturePath>
		<maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
		<allowedArrivalTemperatureRange>-10~65</allowedArrivalTemperatureRange>
		<configurationListOrderPriority>15</configurationListOrderPriority>
	</FactionDef>

	<FactionDef ParentName="CradleFactionBase">
		<defName>Cradle</defName>
		<label>Cradle Rakkle camp</label>
		<description>This is a Cradle Rakkle camp that captures and breeds Rakkles to be sold as
			slaves, livestock and living vore products. It may appear like a settlement, but in
			reality it is a market for Rakkle trafficking. They are always eager to capture free
			Rakkles for their purposes.</description>
		<colorSpectrum>
			<li>(0.81, 0.31, 0.31)</li>
			<li>(0.81, 0.31, 0.31)</li>
		</colorSpectrum>
	</FactionDef>

	<ThingSetMakerDef>
		<defName>RakkleRaidLootMaker</defName>
		<root Class="ThingSetMaker_MarketValue">
			<fixedParams>
				<filter>
					<thingDefs>
						<li>Silver</li>
						<li>MedicineIndustrial</li>
						<li>Neutroamine</li>
						<li>GoJuice</li>
					</thingDefs>
				</filter>
			</fixedParams>
		</root>
	</ThingSetMakerDef>

</Defs>