  <HediffDef>
    <defName>RS_Shed</defName>
    <label>Shed</label>
    <description>Rakkles periodically shed their skin as they grow.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>47</initialSeverity>
    <maxSeverity>47</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1</severityPerDay>
      </li>
      <li Class="HediffCompProperties_Discoverable">
        <sendLetterWhenDiscovered>true</sendLetterWhenDiscovered>
        <discoverLetterLabel>{0} is preparing to shed off {0}'s skin.</discoverLetterLabel>
        <discoverLetterText>{0}'s skin shedding is not far off!</discoverLetterText>
        <letterType>PositiveEvent</letterType>
        <messageType>PositiveEvent</messageType>
      </li>
      <li Class="MoharHediffs.HediffCompProperties_Spawner">
        <thingToSpawn>RS_SnakeSkin</thingToSpawn>
        <spawnCount>4</spawnCount>
        <minDaysB4Next>45</minDaysB4Next>
        <maxDaysB4Next>45.01</maxDaysB4Next>
        <randomGrace>0</randomGrace>
        <spawnMaxAdjacent>40</spawnMaxAdjacent>
        <spawnForbidden>false</spawnForbidden>
        <spawnVerb>production</spawnVerb>
      </li>
      <li Class="MoharHediffs.HediffCompProperties_PostRemoveTrigger_HediffAdd">
        <triggeredHediff>
          <li>RS_Shed</li>
        </triggeredHediff>
      </li>
      <li Class="Rakkle.HediffCompProperties_Nullifier">
        <hediffToNullify>
          <li>Hediff_RakkleShedPromoterM</li>
        </hediffToNullify>
      </li>
    </comps>
    <stages>
      <li>
        <label>drying</label>
        <painOffset>0.1</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.8</postFactor>
          </li>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.4</postFactor>
          </li>
          <li>
            <capacity>Eating</capacity>
            <postFactor>0.5</postFactor>
          </li>
          <li>
            <capacity>Talking</capacity>
            <postFactor>0.8</postFactor>
          </li>
          <li>
            <capacity>Sight</capacity>
            <postFactor>0.8</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <label>shedding</label>
        <minSeverity>2</minSeverity>
        <painOffset>0.2</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.8</postFactor>
          </li>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.3</postFactor>
          </li>
          <li>
            <capacity>Eating</capacity>
            <postFactor>0.6</postFactor>
          </li>
          <li>
            <capacity>Talking</capacity>
            <postFactor>0.6</postFactor>
          </li>
          <li>
            <capacity>Sight</capacity>
            <postFactor>0.7</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <label>last</label>
        <minSeverity>3</minSeverity>
        <painOffset>-0.2</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>1.1</postFactor>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <postFactor>1.1</postFactor>
          </li>
          <li>
            <capacity>Eating</capacity>
            <postFactor>0.8</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <label>middle</label>
        <becomeVisible>false</becomeVisible>
        <minSeverity>13</minSeverity>
        <capMods>
        </capMods>
      </li>
      <li>
        <label>early</label>
        <becomeVisible>false</becomeVisible>
        <minSeverity>25</minSeverity>
        <capMods>
        </capMods>
      </li>
    </stages>
  </HediffDef>
-->

  <HediffDef>
    <defName>Hediff_helminthicHigh</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <description>Medicine against muscle parasites and gut worms.</description>
    <label>Parasites treatment</label>
    <labelNoun>Parasites treatment</labelNoun>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1000</severityPerDay>
      </li>
      <li Class="Rakkle.HediffCompProperties_Nullifier">
        <limitedUsageNumber>1</limitedUsageNumber>
        <hediffToNullify>
          <li>MuscleParasites</li>
          <li>GutWorms</li>
        </hediffToNullify>
      </li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="AddedBodyPartBase">
    <defName>Hediff_BionicTail</defName>
    <label>bionic Rakkle tail</label>
    <labelNoun>a bionic Rakkle tail</labelNoun>
    <description>An installed bionic Rakkle tail.</description>
    <descriptionHyperlinks>
      <ThingDef>RS_BionicTail</ThingDef>
    </descriptionHyperlinks>
    <spawnThingOnRemoved>RS_BionicTail</spawnThingOnRemoved>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>1.25</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
  </HediffDef>


  <HediffDef ParentName="AddedBodyPartBase">
    <defName>Hediff_WoodenTail</defName>
    <label>prosthetic wooden tail</label>
    <labelNoun>a prosthetic wooden tail</labelNoun>
    <description>An installed prosthetic wooden tail.</description>
    <descriptionHyperlinks>
      <ThingDef>RS_WoodenTail</ThingDef>
    </descriptionHyperlinks>
    <priceImpact>false</priceImpact>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>0.75</partEfficiency>
    </addedPartProps>
    <spawnThingOnRemoved>WoodLog</spawnThingOnRemoved>
  </HediffDef>

  <HediffDef ParentName="AddedBodyPartBase">
    <defName>Hediff_Thermostat</defName>
    <label>Rakkle hyporegulator</label>
    <labelNoun>a Rakkle hyporegulator</labelNoun>
    <description>An installed Rakkle hyporegulator.</description>
    <descriptionHyperlinks>
      <ThingDef>RS_Thermostat</ThingDef>
    </descriptionHyperlinks>
    <spawnThingOnRemoved>RS_Thermostat</spawnThingOnRemoved>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>1</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
    <stages>
      <li>
        <statOffsets>
          <ComfyTemperatureMax>10</ComfyTemperatureMax>
          <ComfyTemperatureMin>-20</ComfyTemperatureMin>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>