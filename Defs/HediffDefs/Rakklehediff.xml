<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Food Poisoning Immunity -->

  <HediffDef>
    <defName>Hediff_FoodpoisoningImmunity</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <description>Immune to food poisoning.</description>
    <label>food poisoning immunity</label>
    <labelNoun>food poisoning immunity</labelNoun>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
    <comps>
      <li Class="Rakkle.HediffCompProperties_Nullifier">
        <hediffToNullify>
          <li>FoodPoisoning</li>
        </hediffToNullify>
      </li>
    </comps>
  </HediffDef>

  <!-- Hidden quirk carrier for the predatory compulsion gene -->
  <HediffDef>
    <defName>RS_PredatorObsession</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>predatory compulsion</label>
    <labelNoun>predatory compulsion</labelNoun>
    <description>Engineered instincts that drive this pawn to see other beings as prey.</description>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
    <comps>
      <li Class="RimVore2.HediffCompProperties_QuirkForcer">
        <quirks>
          <li>PredatorDisposition_Obsessed</li>
        </quirks>
      </li>
    </comps>
  </HediffDef>

  <!-- Predation growth: grants and upgrades the Rakkle's engulfing tongue ability once it has
       digested enough prey (see RakkleTongueUpgrade.cs) -->
  <HediffDef>
    <defName>Hediff_VoreTongueGrowth</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>predation growth</label>
    <labelNoun>predation growth</labelNoun>
    <description>Tracks how much prey this Rakkle has digested and grows its engulfing tongue
      accordingly.</description>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
    <comps>
      <li Class="Rakkle.HediffCompProperties_VoreTongueUpgrade">
        <digestionRecord>RV2_Goal_Digest_Predator</digestionRecord>
        <upgradeThresholds>
          <li>10</li>
          <li>23</li>
        </upgradeThresholds>
        <abilitiesToGrant>
          <li>RS_VoreTongue1</li>
          <li>RS_VoreTongue2</li>
        </abilitiesToGrant>
      </li>
    </comps>
  </HediffDef>

  <!-- Vore dependency: the pawn must periodically digest prey or weaken (see
  RakkleVoreDependency.cs) -->
  <HediffDef>
    <defName>RS_VoreDependency</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>predation hunger</label>
    <labelNoun>predation hunger</labelNoun>
    <description>This pawn's engineered metabolism expects live prey. Go too long without digesting
      someone and it begins to weaken.</description>
    <defaultLabelColor>(0.9, 0.5, 0.4)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>0.001</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="Rakkle.HediffCompProperties_VoreDependency">
        <feedingRecords>
          <li>RV2_Goal_Digest_Predator</li>
        </feedingRecords>
        <starvationDays>5</starvationDays>
      </li>
    </comps>
    <stages>
      <li>
        <label>sated</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <label>hungry</label>
        <minSeverity>0.2</minSeverity>
        <painOffset>0.05</painOffset>
        <statOffsets>
          <MoveSpeed>-0.4</MoveSpeed>
        </statOffsets>
      </li>
      <li>
        <label>starving</label>
        <minSeverity>0.55</minSeverity>
        <painOffset>0.15</painOffset>
        <statOffsets>
          <MoveSpeed>-0.9</MoveSpeed>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.9</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>ravenous</label>
        <minSeverity>0.85</minSeverity>
        <painOffset>0.3</painOffset>
        <statOffsets>
          <MoveSpeed>-1.5</MoveSpeed>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.8</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="AddedBodyPartBase">
    <defName>Hediff_VenomGlands</defName>
    <label>venom glands</label>
    <labelNoun>venom glands</labelNoun>
    <description>A Rakkle's venom glands.</description>
    <descriptionHyperlinks>
      <ThingDef>RS_VenomGlands</ThingDef>
    </descriptionHyperlinks>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>fangs</label>
            <capacities>
              <li>RS_AnestheticBiteTool</li>
            </capacities>
            <power>2</power>
            <cooldownTime>2</cooldownTime>
            <chanceFactor>1.5</chanceFactor>
            <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
          </li>
        </tools>
      </li>
    </comps>
    <addedPartProps>
      <solid>false</solid>
      <partEfficiency>1.2</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
  </HediffDef>

  <HediffGiverSetDef>
    <defName>Rakkle_BasicHediffSet</defName>
    <hediffGivers>
      <li Class="HediffGiver_Birthday">
        <hediff>Hediff_Shed</hediff>
        <ageFractionChanceCurve>
          <points>
            <li>(0, 1)</li>
          </points>
        </ageFractionChanceCurve>
      </li>
      <li Class="HediffGiver_Birthday">
        <hediff>Hediff_VenomGlands</hediff>
        <ageFractionChanceCurve>
          <points>
            <li>(0, 1)</li>
          </points>
        </ageFractionChanceCurve>
        <partsToAffect>
          <li>RS_VenomGlands</li>
        </partsToAffect>
      </li>
    </hediffGivers>
  </HediffGiverSetDef>

  <!-- Shedding New -->

  <HediffDef>
    <defName>Hediff_Shed</defName>
    <hediffClass>HediffWithComps</hediffClass>

    <description>Rakkles periodically shed their skin as they grow.</description>
    <label>Shedding</label>
    <labelNoun>If you see this text, it's a bug.</labelNoun>
    <defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
    <isBad>false</isBad>


    <comps>
      <li Class="Rakkle.HediffCompProperties_Spawner">
        <thingToSpawn>RS_SnakeSkin</thingToSpawn>
        <!-- must be lower than 200; dll limited -->
        <spawnCount>1</spawnCount>

        <!-- must be higher than maxDaysB4Next ; must be higher than .001; default = 1; dll
        limited-->
        <minDaysB4Next>2.22</minDaysB4Next>
        <!-- default = 2 -->
        <maxDaysB4Next>3.33</maxDaysB4Next>
        <!-- default = .5 -->
        <graceDays>0</graceDays>

        <spawnMaxAdjacent>40</spawnMaxAdjacent>
        <spawnForbidden>false</spawnForbidden>
        <spawnVerb>shedding</spawnVerb>

      </li>
    </comps>
  </HediffDef>

  <!-- Constriction charge: builds up with each Rakkle melee hit; when full the Rakkle automatically
       tries to seize the victim in a RimVore2 grapple (see RakkleConstriction.cs) -->
  <HediffDef>
    <defName>RS_ConstrictCharge</defName>
    <label>constriction charge</label>
    <labelNoun>constriction charge</labelNoun>
    <description>A Rakkle's body coiling up for a vore grapple. It builds with every melee hit and
      drains away when the Rakkle stops attacking.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.72, 0.35)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="Rakkle.HediffCompProperties_ConstrictCharge">
        <severityPerHit>0.25</severityPerHit>
        <decayPerDay>2</decayPerDay>
        <triggerThreshold>1</triggerThreshold>
      </li>
    </comps>
  </HediffDef>


  <!-- Shedding old

  <HediffDef ParentName="DrugToleranceBase">
    <defName>Hediff_RakkleShedPromoterT</defName>
    <label>RakkleShedPromoterlabelT</label>
    <description>PromoterT - If you see this text, it's a bug.</description>
  </HediffDef>

  <HediffDef ParentName="AddictionBase">
    <defName>Hediff_RakkleShedPromoterA</defName>
    <hediffClass>Hediff_Addiction</hediffClass>
    <label>RakkleShedPromoterlabelA</label>
    <scenarioCanAdd>false</scenarioCanAdd>
    <description>PromoterA - If you see this text, it's a bug.</description>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Hediff_RakkleShedPromoterM</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>RakkleShedPromoterlabelM</label>
    <defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <description>PromoterM - If you see this text, it's a bug.</description>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>end</label>
        <becomeVisible>false</becomeVisible>
        <hediffGivers>
          <li Class="Rakkle.HediffGiver_AlramX">
            <hediff>RS_Shed</hediff>
            <mtbDays>0.5</mtbDays>
          </li>
        </hediffGivers>
      </li>
      <li>
        <label>start</label>
        <becomeVisible>false</becomeVisible>
        <minSeverity>0.9</minSeverity>
